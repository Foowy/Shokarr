<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RepositoryUrl>https://github.com/Foowy/ShokoArr</RepositoryUrl>
    <PackageTags>hosted-service, sonarr, radarr, missing-episodes</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Title>Shoko Arr</Title>
    <Authors>Foowy</Authors>
    <Version>0.9.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only (host supplies at runtime); must match the Shoko host's bundled version or the plugin fails to load. -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" ExcludeAssets="runtime" />
    <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.94" ExcludeAssets="runtime" />
    <PackageReference Include="NLog" Version="6.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Shoko.BuildTools.Targets" Version="0.3.1" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\Icon.png" LogicalName="ShokoArr.assets.Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Dashboard\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>dashboard\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
